@model List<Sistema_Ventas.Models.Evento>

@{
    ViewData["Title"] = "Cartelera de eventos";
}

<div class="container mt-4 mb-5">

    <div class="text-center mb-5">
        <h1>Descubre próximos eventos</h1>
        <p>Encuentra experiencias, espectáculos y actividades para disfrutar.</p>
    </div>

    <!-- FILTROS -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-4">

            <h4 class="mb-3">Buscar eventos</h4>

            <form asp-controller="Evento" asp-action="Cartelera" method="get">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label for="nombre" class="form-label">
                            Nombre del evento
                        </label>

                        <input type="text"
                               id="nombre"
                               name="nombre"
                               class="form-control"
                               placeholder="Buscar por nombre..."
                               value="@ViewBag.Nombre" />
                    </div>

                    <div class="col-md-6">
                        <label for="categoria" class="form-label">
                            Categoría
                        </label>

                        <select id="categoria"
                                name="categoria"
                                class="form-select">

                            <option value="">Todas las categorías</option>

                            <option value="Conciertos"
                                    selected="@(ViewBag.Categoria?.ToString() == "Conciertos")">
                                Conciertos
                            </option>

                            <option value="Gastronomía"
                                    selected="@(ViewBag.Categoria?.ToString() == "Gastronomía")">
                                Gastronomía
                            </option>

                            <option value="Teatro"
                                    selected="@(ViewBag.Categoria?.ToString() == "Teatro")">
                                Teatro
                            </option>

                            <option value="Deportes"
                                    selected="@(ViewBag.Categoria?.ToString() == "Deportes")">
                                Deportes
                            </option>

                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="fecha" class="form-label">
                            Fecha del evento
                        </label>

                        <input type="date"
                               id="fecha"
                               name="fecha"
                               class="form-control"
                               value="@ViewBag.Fecha" />
                    </div>

                    <div class="col-md-6">
                        <label for="ciudad" class="form-label">
                            Ciudad
                        </label>

                        <input type="text"
                               id="ciudad"
                               name="ciudad"
                               class="form-control"
                               placeholder="Buscar por ciudad..."
                               value="@ViewBag.Ciudad" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2 flex-wrap">

                    <button type="submit" class="btn btn-primary">
                        Buscar eventos
                    </button>

                    <a asp-controller="Evento"
                       asp-action="Cartelera"
                       class="btn btn-outline-secondary">
                        Limpiar filtros
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- RESULTADOS -->
    <div class="mb-4">
        <h3>Eventos disponibles</h3>
        <p class="text-muted">
            Encuentra tu próximo evento favorito.
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5">
            <h4>No se encontraron eventos</h4>
            <p class="text-muted">
                Intenta cambiar los filtros de búsqueda.
            </p>

            <a asp-controller="Evento"
               asp-action="Cartelera"
               class="btn btn-outline-primary">
                Ver todos los eventos
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var evento in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrEmpty(evento.Imagen))
                        {
                            <img src="@evento.Imagen"
                                 class="card-img-top"
                                 alt="@evento.Nombre"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">Imagen no disponible</span>
                            </div>
                        }

                        <div class="card-body">

                            <span class="badge bg-secondary mb-2">
                                @evento.Categoria
                            </span>

                            <h5 class="card-title">@evento.Nombre</h5>

                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar-event"></i>
                                @evento.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <p class="text-muted mb-2">
                                <i class="bi bi-geo-alt"></i>
                                @evento.Lugar, @evento.Ciudad
                            </p>

                            <p class="fw-bold">
                                Desde ₡@evento.PrecioInicial.ToString("N2")
                            </p>

                            <a asp-controller="Evento"
                               asp-action="Detalle"
                               asp-route-id="@evento.IdEvento"
                               class="btn btn-outline-primary w-100">
                                Ver detalle
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
