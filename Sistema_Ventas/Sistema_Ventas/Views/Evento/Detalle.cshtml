@model Sistema_Ventas.ViewModels.ReservaViewModel
@{
    var evento = ViewBag.Evento as Sistema_Ventas.Models.Evento;
    var idReservaPendiente = ViewBag.IdReservaPendiente as int?;
    ViewData["Title"] = evento?.Nombre ?? "Detalle del evento";
}

<div class="container mt-4 mb-5">
    <div class="mb-3">
        <a asp-controller="Evento" asp-action="Cartelera" class="btn btn-outline-secondary btn-sm">
            &larr; Volver a la cartelera
        </a>
    </div>

    <div class="row g-4">
        <!-- INFO EVENTO -->
        <div class="col-md-7">
            @if (!string.IsNullOrEmpty(evento.Imagen))
            {
                <img src="@evento.Imagen" class="img-fluid rounded mb-3" alt="@evento.Nombre" style="max-height: 400px; object-fit: cover; width: 100%;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded mb-3" style="height: 300px;">
                    <span class="text-muted">Imagen no disponible</span>
                </div>
            }

            <span class="badge bg-secondary mb-2">@evento.Categoria</span>
            <h2 class="mt-2">@evento.Nombre</h2>
            <p class="text-muted mb-2"><i class="bi bi-calendar-event"></i> @evento.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy, HH:mm")</p>
            <p class="text-muted mb-2"><i class="bi bi-geo-alt"></i> @evento.Lugar, @evento.Ciudad</p>
            <hr />
            <h5>Descripción</h5>
            <p>@evento.Descripcion</p>
        </div>

        <!-- TABLA Y COMPRA -->
        <div class="col-md-5">
            <div class="sticky-top" style="top: 20px;">
                
                <!-- TABLA DE SECTORES -->
                <div class="card border mb-4" style="border-color: #e1e5eb;">
                    <div class="card-header" style="background-color: #24344D; border-bottom: none;">
                        <h5 class="mb-0 text-white">Sectores disponibles</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.Sectores == null || !Model.Sectores.Any())
                        {
                            <div class="alert alert-warning m-3 mb-0">Este evento aún no tiene sectores configurados.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sector</th>
                                            <th class="text-end">Precio</th>
                                            <th class="text-end">Disponibles</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sector in Model.Sectores)
                                        {
                                            <tr>
                                                <td>@sector.Nombre</td>
                                                <td class="text-end">₡@sector.Precio.ToString("N2")</td>
                                                <td class="text-end">
                                                    @if (sector.Disponibles <= 0)
                                                    {
                                                        <span class="text-danger fw-bold">Agotado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold">@sector.Disponibles</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <!-- FORMULARIO DE COMPRA -->
                <div class="card border p-4" style="border-color: #e1e5eb;">
                    <h4 class="mb-3">Comprar entradas</h4>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <!-- BLOQUEO VISUAL -->
                    @if (idReservaPendiente.HasValue)
                    {
                        <div class="border rounded p-4 text-center bg-white" style="border-color: #cbd3df !important;">
                            <h5 class="mb-2 fw-bold text-dark"><i class="bi bi-clock text-muted"></i> Tienes una compra en proceso</h5>
                            <p class="text-muted small mb-4">Debes terminar tu pago o cancelar la reserva anterior para poder comprar más entradas.</p>
                            <a asp-controller="Pago" asp-action="Pagar" asp-route-idReserva="@idReservaPendiente" class="btn btn-primary w-100">
                                Ir a terminar mi pago
                            </a>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Reservar" method="post" id="formReserva">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="IdEvento" />
                            <input type="hidden" asp-for="NombreEvento" />

                            <div class="mb-3">
                                <label class="form-label">Seleccione Sector</label>
                                <select asp-for="IdSector" class="form-select" id="selectSector">
                                    <option value="">-- Seleccione un sector --</option>
                                    @foreach (var sector in Model.Sectores)
                                    {
                                        var agotado = sector.Disponibles <= 0;
                                        <option value="@sector.IdSector" data-precio="@sector.Precio" data-max="@sector.Disponibles" disabled="@agotado">
                                            @sector.Nombre - ₡@sector.Precio.ToString("N2")
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="IdSector" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Cantidad</label>
                                <input asp-for="Cantidad" type="number" class="form-control" min="1" max="6" value="1" id="inputCantidad" />
                                <small class="text-muted">Máximo 6 entradas por compra.</small>
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                                <small class="text-danger d-none d-block" id="msgLimite">No hay suficientes entradas disponibles en este sector.</small>
                            </div>

                            <div class="alert alert-light border d-flex justify-content-between mb-4">
                                <span><strong>Total a pagar:</strong></span>
                                <span id="totalPagar" class="fw-bold" style="color: var(--azul-principal);">₡0.00</span>
                            </div>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                if (User.IsInRole("Cliente"))
                                {
                                    <button type="submit" class="btn btn-primary w-100" id="btnReservar">
                                        Reservar por 10 minutos
                                    </button>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">Solo los clientes pueden comprar entradas.</div>
                                }
                            }
                            else
                            {
                                <a asp-controller="Usuario" asp-action="IniciarSesion" class="btn btn-primary w-100">
                                    Inicie sesión para comprar
                                </a>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectSector = document.getElementById('selectSector');
            const inputCantidad = document.getElementById('inputCantidad');
            const msgLimite = document.getElementById('msgLimite');
            const btnReservar = document.getElementById('btnReservar');
            const totalPagar = document.getElementById('totalPagar');

            if (!selectSector || !inputCantidad) return;

            function calcularTotal() {
                const opt = selectSector.options[selectSector.selectedIndex];
                const precio = parseFloat(opt?.getAttribute('data-precio')) || 0;
                const maxDisponibles = parseInt(opt?.getAttribute('data-max')) || 0;
                const maxPermitido = Math.min(6, maxDisponibles);
                
                inputCantidad.max = maxPermitido > 0 ? maxPermitido : 1;
                let cantidad = parseInt(inputCantidad.value) || 0;
                const excede = (cantidad > maxDisponibles) || (maxDisponibles === 0);

                if (excede) {
                    msgLimite.classList.remove('d-none');
                    if (btnReservar) btnReservar.disabled = true;
                } else {
                    msgLimite.classList.add('d-none');
                    if (btnReservar) btnReservar.disabled = false;
                }

                const total = precio * cantidad;
                totalPagar.innerHTML = '₡' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            selectSector.addEventListener('change', function () {
                inputCantidad.value = 1;
                calcularTotal();
            });
            inputCantidad.addEventListener('input', calcularTotal);
            calcularTotal();
        });
    </script>
}