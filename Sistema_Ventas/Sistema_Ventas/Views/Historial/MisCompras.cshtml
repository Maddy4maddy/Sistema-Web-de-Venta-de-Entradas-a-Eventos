@model List<Sistema_Ventas.ViewModels.CompraHistorialViewModel>

@{
    ViewData["Title"] = "Mis compras";
}

<div class="container mt-5 mb-5">
    <h1 class="mb-4">Historial de compras</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Aún no tienes compras registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Evento</th>
                        <th>Fecha del evento</th>
                        <th>Sector</th>
                        <th>Entradas</th>
                        <th>Total</th>
                        <th>Códigos de entradas</th>
                        <th>Fecha de compra</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var compra in Model)
                    {
                        <tr>
                            <td>@compra.NombreEvento</td>
                            <td>@compra.FechaEvento.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@compra.NombreSector</td>
                            <td>@compra.Cantidad</td>
                            <td>₡ @compra.Total.ToString("N2")</td>
                            <td>
                                @if (compra.CodigosEntradas.Count == 0)
                                {
                                    <span class="text-muted">Sin entradas emitidas</span>
                                }
                                else
                                {
                                    @foreach (var codigo in compra.CodigosEntradas)
                                    {
                                        <div class="text-break">@codigo</div>
                                    }
                                }
                            </td>
                            <td>@compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Evento" asp-action="Cartelera" class="btn btn-primary">
        Volver a eventos
    </a>
</div>
