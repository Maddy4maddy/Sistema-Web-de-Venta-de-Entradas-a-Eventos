@model Sistema_Ventas.ViewModels.EventoOrganizadorViewModel

@{
    ViewData["Title"] = Model.IdEvento == 0 ? "Crear evento" : "Editar evento";
}

<div class="container mt-5 mb-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-controller="Organizador"
          asp-action="GuardarEvento"
          method="post">

        <input asp-for="IdEvento" type="hidden" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre del evento</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Categoria" class="form-label">Categoría</label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Fecha" class="form-label">Fecha y hora</label>
                <input asp-for="Fecha" type="datetime-local" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Lugar" class="form-label">Lugar</label>
                <input asp-for="Lugar" class="form-control" />
                <span asp-validation-for="Lugar" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Ciudad" class="form-label">Ciudad</label>
                <input asp-for="Ciudad" class="form-control" />
                <span asp-validation-for="Ciudad" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Imagen" class="form-label">Ruta de la imagen</label>
            <input asp-for="Imagen" class="form-control" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Sectores, precios y aforo</h2>

            <button type="button"
                    id="agregarSector"
                    class="btn btn-outline-primary">
                Agregar sector
            </button>
        </div>

        <div id="listaSectores">
            @for (int i = 0; i < Model.Sectores.Count; i++)
            {
                <div class="card p-3 mb-3 sector-item">
                    <input asp-for="Sectores[i].IdSector" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Sectores[i].Nombre" class="form-label">
                            Nombre del sector
                        </label>
                        <input asp-for="Sectores[i].Nombre" class="form-control" />
                        <span asp-validation-for="Sectores[i].Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Sectores[i].Precio" class="form-label">
                                Precio
                            </label>
                            <input asp-for="Sectores[i].Precio"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />
                            <span asp-validation-for="Sectores[i].Precio"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Sectores[i].Capacidad" class="form-label">
                                Aforo
                            </label>
                            <input asp-for="Sectores[i].Capacidad"
                                   type="number"
                                   min="1"
                                   class="form-control" />
                            <span asp-validation-for="Sectores[i].Capacidad"
                                  class="text-danger"></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <template id="plantillaSector">
            <div class="card p-3 mb-3 sector-item">
                <input type="hidden"
                       name="Sectores[__INDICE__].IdSector"
                       value="0" />

                <div class="mb-3">
                    <label class="form-label">Nombre del sector</label>
                    <input name="Sectores[__INDICE__].Nombre"
                           maxlength="100"
                           required
                           class="form-control" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Precio</label>
                        <input name="Sectores[__INDICE__].Precio"
                               type="number"
                               min="0.01"
                               step="0.01"
                               required
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Aforo</label>
                        <input name="Sectores[__INDICE__].Capacidad"
                               type="number"
                               min="1"
                               required
                               class="form-control" />
                    </div>
                </div>
            </div>
        </template>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                Guardar evento
            </button>

            <a asp-controller="Organizador"
               asp-action="MisEventos"
               class="btn btn-outline-secondary">
                Volver a mis eventos
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const listaSectores = document.getElementById("listaSectores");
        const plantillaSector = document.getElementById("plantillaSector");
        const botonAgregarSector = document.getElementById("agregarSector");

        let indiceSector = listaSectores.querySelectorAll(".sector-item").length;

        botonAgregarSector.addEventListener("click", function () {
            const htmlSector = plantillaSector.innerHTML
                .replaceAll("__INDICE__", indiceSector);

            listaSectores.insertAdjacentHTML("beforeend", htmlSector);
            indiceSector++;
        });
    </script>
}
