@model ResultadoPagoViewModel

@{
    ViewData["Title"] = "Resultado del Pago";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            
            @if (Model.Estado == "Aprobado")
            {
                <div class="card shadow border-success">
                    <div class="card-body p-5">
                        <h1 class="display-4 text-success"></h1>
                        <h3 class="text-success">¡Pago Aprobado!</h3>
                        <p class="lead">@Model.Mensaje</p>
                        <hr />
                        <p class="text-muted">Tus entradas han sido emitidas correctamente.</p>
                        <div class="list-group text-start mt-4">
                            @for (int i = 0; i < Model.CodigosEntradas.Count; i++)
                            {
                                <div class="list-group-item">
                                    <span class="fw-semibold">Entrada @(i + 1)</span>
                                    <div class="font-monospace text-break">@Model.CodigosEntradas[i]</div>
                                </div>
                            }
                        </div>
                        <a asp-controller="Evento" asp-action="Cartelera" class="btn btn-primary mt-3">
                            Volver a la cartelera
                        </a>
                    </div>
                </div>
            }
            else if (Model.Estado == "Rechazado")
            {
                <div class="card shadow border-danger">
                    <div class="card-body p-5">
                        <h1 class="display-4 text-danger"></h1>
                        <h3 class="text-danger">Pago Rechazado</h3>
                        <p class="lead">@Model.Mensaje</p>
                        <hr />
                        <p class="text-muted">Puedes intentar con otra tarjeta mientras tu reserva siga vigente.</p>
                        <a asp-controller="Pago" asp-action="Pagar" asp-route-idReserva="@Model.IdReserva" class="btn btn-warning mt-3">
                            Reintentar pago
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow border-warning">
                    <div class="card-body p-5">
                        <h1 class="display-4 text-warning"></h1>
                        <h3 class="text-warning">Error en el Pago</h3>
                        <p class="lead">@Model.Mensaje</p>
                        <hr />
                        <a asp-controller="Pago" asp-action="Pagar" asp-route-idReserva="@Model.IdReserva" class="btn btn-warning mt-3">
                            Intentar nuevamente
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
