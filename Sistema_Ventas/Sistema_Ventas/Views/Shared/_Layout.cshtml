
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventia</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark barra-navegacion">
            <div class="container">

                <a class="navbar-brand nombre-sistema"
                   asp-controller="Home"
                   asp-action="Index">
                    EVENTIA
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Evento"
                                       asp-action="Cartelera">
                                        Ver eventos
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Mis compras
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Organizador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Mis eventos
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Crear evento
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Reportes de ventas
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Validar entradas
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Gestionar usuarios
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">
                                        Gestionar organizadores
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <span class="nav-link">
                                    Hola, @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Usuario"
                                      asp-action="CerrarSesion"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-cerrar-sesion">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Evento"
                                   asp-action="Cartelera">
                                    Ver eventos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Usuario"
                                   asp-action="IniciarSesion">
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-registro"
                                   asp-controller="Usuario"
                                   asp-action="Registro">
                                    Crear cuenta
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="contenido-principal">
        @RenderBody()
    </main>

    <footer class="pie-pagina">
        <div class="container text-center">
            <p class="mb-1">EVENTIA - Sistema de Venta de Entradas a Eventos</p>
            <small>Todos los derechos reservados.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
