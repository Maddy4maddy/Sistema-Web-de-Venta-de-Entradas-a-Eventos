@model SolicitarRecuperacionViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card p-4">
                <div class="text-center mb-4">
                    <h2>Recuperar contraseña</h2>
                    <p class="text-muted">
                        Ingrese el correo electrónico asociado a su cuenta.
                    </p>
                </div>

                <form asp-controller="Usuario"
                      asp-action="RecuperarContrasena"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               class="form-control"
                               type="email"
                               placeholder="ejemplo@correo.com" />

                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Generar código
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Usuario"
                           asp-action="IniciarSesion">
                            Volver al inicio de sesión
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
