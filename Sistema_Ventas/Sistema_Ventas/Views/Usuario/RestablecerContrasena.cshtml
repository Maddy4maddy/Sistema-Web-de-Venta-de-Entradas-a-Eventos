@model RestablecerContrasenaViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card p-4">

                <div class="text-center mb-4">
                    <h2>Restablecer contraseña</h2>
                    <p class="text-muted">
                        Ingrese el código que recibió en su correo electrónico
                        y establezca una nueva contraseña.
                    </p>
                </div>

                @if (TempData["MensajeCorreo"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["MensajeCorreo"]
                    </div>
                }

                <form asp-controller="Usuario"
                      asp-action="RestablecerContrasena"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <input asp-for="Correo" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label">
                            Código de recuperación
                        </label>

                        <input asp-for="Codigo"
                               class="form-control"
                               maxlength="6"
                               inputmode="numeric"
                               placeholder="Ingrese los 6 dígitos" />

                        <span asp-validation-for="Codigo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevaContrasena"
                               class="form-label">
                            Nueva contraseña
                        </label>

                        <input asp-for="NuevaContrasena"
                               type="password"
                               class="form-control"
                               placeholder="Nueva contraseña" />

                        <span asp-validation-for="NuevaContrasena"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarContrasena"
                               class="form-label">
                            Confirmar contraseña
                        </label>

                        <input asp-for="ConfirmarContrasena"
                               type="password"
                               class="form-control"
                               placeholder="Repita la contraseña" />

                        <span asp-validation-for="ConfirmarContrasena"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Cambiar contraseña
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Usuario"
                           asp-action="IniciarSesion">
                            Volver al inicio de sesión
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
