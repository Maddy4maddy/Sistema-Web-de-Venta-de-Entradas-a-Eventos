@model Sistema_Ventas.ViewModels.ValidacionEntradaViewModel

@{
    ViewData["Title"] = "Validar entradas";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h1 class="mb-2">Validar entradas</h1>
            <p class="text-muted mb-4">Solicita la entrada al asistente y comprueba su código para registrar el acceso a tu evento.</p>

            @if (!string.IsNullOrEmpty(Model.Mensaje))
            {
                <div class="alert @(Model.Validada ? "alert-success" : "alert-danger")" role="alert">
                    @Model.Mensaje
                </div>
            }

            <div class="lector-qr-movil mb-4" id="lectorQrMovil">
                <button type="button" class="btn btn-outline-primary" id="iniciarLectorQr">Escanear QR con la cámara</button>
                <div id="camaraQr" class="mt-3" hidden>
                    <video id="videoQr" class="w-100 rounded bg-dark" autoplay muted playsinline aria-label="Vista de la cámara para escanear la entrada"></video>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-primary" id="leerQrEnfocado" disabled>Leer QR enfocado</button>
                        <button type="button" class="btn btn-outline-secondary" id="detenerLectorQr">Cerrar cámara</button>
                    </div>
                </div>
                <p id="estadoLectorQr" class="mt-2 mb-0" role="status" aria-live="polite" hidden></p>
            </div>

            <form asp-controller="ValidacionEntrada" asp-action="Index" method="post" id="formularioValidacionEntrada">
                <div class="mb-3">
                    <label asp-for="Codigo" class="form-label">Código presentado por el asistente</label>
                    <input asp-for="Codigo" class="form-control" autocomplete="off" autocapitalize="characters"
                           placeholder="ENT-..." aria-describedby="ayudaCodigo" />
                    <div id="ayudaCodigo" class="form-text">Escribe o pega el código ENT-... que aparece junto al QR de la entrada.</div>
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Validar entrada</button>
                <div id="confirmacionValidacion" class="border rounded p-3 mt-3" role="group" aria-labelledby="tituloConfirmacion" hidden>
                    <p id="tituloConfirmacion" class="fw-semibold mb-2">¿Confirmas que quieres validar esta entrada?</p>
                    <p class="mb-3">Código: <strong id="codigoConfirmacion" class="text-break"></strong>. Si es válida, quedará marcada como usada.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-primary" id="confirmarValidacion">Sí, registrar acceso</button>
                        <button type="button" class="btn btn-outline-secondary" id="cancelarValidacion">Cancelar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacion-qr.js" asp-append-version="true"></script>
}
